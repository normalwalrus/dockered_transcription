# Host port to expose the API on
PORT=8000

# Host port for the Gradio frontend
FRONTEND_PORT=7860

# Path inside the container (./models on the host is mounted at /models)
MODEL_PATH=/models/whisper-large-v3-turbo-ct2

# auto | cuda | cpu
DEVICE=auto

# auto -> float16 on GPU, int8 on CPU. Other values: float16, int8, int8_float16, float32
COMPUTE_TYPE=auto

# 0 lets ctranslate2 choose (CPU mode only)
CPU_THREADS=0

# Reject uploads larger than this
MAX_UPLOAD_MB=200

# Decoding beam size (1 = greedy, fastest)
BEAM_SIZE=5

# Leave empty to disable auth. If set, clients must send X-API-Key: <value>
API_KEY=
